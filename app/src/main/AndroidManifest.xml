<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nearby Connections: local Bluetooth/Wi-Fi P2P, no internet/server involved. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Only required pre-API 31, where BLE scanning still requires location. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Rider's foreground service: keeps listening for a route, and stays
         exempt from background-activity-start restrictions, while RideLink
         itself is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice chat: local mic capture/playback over the same Nearby link,
         still no internet/server involved. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <!-- Not required: a phone without a mic can still pair and share routes. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- API 30+ package visibility: needed to explicitly launch Google Maps. -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".RideLinkApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.RideLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.RideLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share target: appears in the OS share sheet when the pillion taps
             "Share" on a route in Google Maps, so the link is captured with
             no copy/paste and no messaging app in between. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.RideLink.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Keeps listening for a route, and launching Google Maps for each
             one, while the rider has RideLink backgrounded. Declares the
             superset of types it may use: "microphone" is only actually
             active while a voice chat call is in progress (see
             ConnectionNotificationHost), added/removed dynamically rather
             than held the whole time. -->
        <service
            android:name=".rider.RiderForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- Mirrors RiderForegroundService for the Pillion role. -->
        <service
            android:name=".pillion.PillionForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- Handles taps on the connected-status notification's action
             buttons (Voice Chat, Accept/Decline, Mute, End, Disconnect).
             Every PendingIntent targets it explicitly, so no intent-filter
             is needed. -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

    </application>
</manifest>
